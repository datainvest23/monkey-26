{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "patternProperties": {
    "^[a-z_]+$": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticker": { "type": "string" },
          "name": { "type": "string" },
          "sector": { "type": "string" },
          "industry": { "type": "string" },
          "size_band": { "type": "string" },
          "price": { "type": ["string", "null"] },
          "return_pct": { "type": ["string", "null"] }
        },
        "required": ["ticker", "name", "sector", "industry", "size_band"],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
